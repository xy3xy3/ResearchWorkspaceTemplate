# Independent repositories, not submodules.
/repos/*
!/repos/.gitkeep
/paper/*
!/paper/.gitkeep
/refrepo/*
!/refrepo/.gitkeep
/ref/*/repo/
# Literature archive: text and metadata only, including case variants.
/ref/**/*.[pP][dD][fF]
/ref/**/*.[pP][nN][gG]
/ref/**/*.[jJ][pP][gG]
/ref/**/*.[jJ][pP][eE][gG]
/ref/**/*.[gG][iI][fF]
/ref/**/*.[wW][eE][bB][pP]
/ref/**/*.[sS][vV][gG]
/ref/**/*.[tT][iI][fF]
/ref/**/*.[tT][iI][fF][fF]
/ref/**/*.[bB][mM][pP]
/ref/**/*.[aA][vV][iI][fF]
/ref/**/*.[eE][pP][sS]
/ref/**/*.zip
/ref/**/images/
/ref/.staging-*/
# Local execution and machine state.
/.runtime/
/workspace.local.json
/local/
/data/
/logs/
.worktrees/
**/.env
**/.env.*
!**/.env.example
__pycache__/
*.py[cod]
.DS_Store
# task/, research/, spec/ and ref text/metadata remain tracked.
