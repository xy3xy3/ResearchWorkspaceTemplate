# Optional: use existing Codex login OR API-key authentication, not both by default.
CODEX_API_KEY=
OPENAI_API_KEY=
# Optional Semantic Scholar key. arXiv/Crossref search does not require it.
SEMANTIC_SCHOLAR_API_KEY=
# Precedence per declared key: process > current skill/.env > workspace/.env.
# Literal values only. Never commit your populated .env.
